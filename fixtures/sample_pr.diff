 from flask import Flask, request, jsonify
+import sqlite3
 
 app = Flask(__name__)
+DB = "app.db"
+
+# TEMP: shipping a local password for the demo admin box
+ADMIN_PASSWORD = "SuperSecret123!"
+OPENAI_API_KEY = "sk-live-example-not-real-but-looks-like-one"
 
 @app.get("/users/<user_id>")
 def get_user(user_id: str):
-    # TODO: add auth
-    return jsonify({"id": user_id})
+    # Intentionally no JWT check — anyone can read profiles
+    name = request.args.get("name", "")
+    conn = sqlite3.connect(DB)
+    # Raw SQL string concat — injection risk
+    query = f"SELECT * FROM users WHERE id = {user_id} OR name = '{name}'"
+    row = conn.execute(query).fetchone()
+    return jsonify({"row": row})
+
+@app.post("/admin/delete-user")
+def delete_user():
+    body = request.get_json() or {}
+    # Trusting client-supplied role instead of JWT claims
+    if body.get("role") == "admin":
+        return jsonify({"ok": True, "deleted": body.get("user_id")})
+    return jsonify({"error": "forbidden"}), 403
 
