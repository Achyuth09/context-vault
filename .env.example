# Phase 1: local MiniLM embeddings — no key needed for ingest/query.
# Phase 2+: Gemini contradiction judge (unless CONFLICT_JUDGE=heuristic)
GEMINI_API_KEY=your_key_here

# PR review (default provider = qwen via OpenRouter + OpenAI SDK)
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here
# REVIEW_LLM=qwen
# OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional (from OpenRouter docs / playground):
# OPENROUTER_REASONING=true
# OPENROUTER_PROVIDER_ONLY=modelrun/fp4
# OPENROUTER_ALLOW_FALLBACKS=false

# GitHub PR fetch / optional post-review (fine-scoped PAT)
# https://github.com/settings/tokens
# Needs: pull_requests read; add write if using --post-review
GITHUB_TOKEN=your_github_pat_here

# Optional overrides
# CHUNK_STRATEGY=fixed          # fixed | by_heading | by_paragraph
# CHUNK_SIZE=400
# CHUNK_OVERLAP=50
# RETRIEVAL_STRATEGY=similarity # similarity | recency_boosted | filter_stale
# CONFLICT_JUDGE=gemini         # gemini | heuristic
# GEMINI_MODEL=gemini-3.5-flash
# DEFAULT_TOP_K=5
# FRESH_DAYS=30
# AGING_DAYS=90
